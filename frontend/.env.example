# ============================================================
# ExMarket — Environment Configuration
# ============================================================
# Copy this to .env.local and fill in your values:
#   cp .env.example .env.local
# ============================================================

# ── Network ──────────────────────────────────────
# Options: testnet | shelbynet
# testnet   → runs on Aptos testnet validators
# shelbynet → Shelby's own dev prototype network (wiped weekly)
NEXT_PUBLIC_NETWORK=testnet

# ── Aptos Node & Indexer ─────────────────────────
# testnet:
NEXT_PUBLIC_APTOS_NODE_URL=https://api.testnet.aptoslabs.com/v1
NEXT_PUBLIC_APTOS_INDEXER_URL=https://api.testnet.aptoslabs.com/v1/graphql
# shelbynet (uncomment if using shelbynet):
# NEXT_PUBLIC_APTOS_NODE_URL=https://api.shelbynet.shelby.xyz/v1
# NEXT_PUBLIC_APTOS_INDEXER_URL=https://api.shelbynet.shelby.xyz/v1/graphql

# ── Shelby RPC ───────────────────────────────────
# testnet:
NEXT_PUBLIC_SHELBY_RPC_URL=https://api.testnet.shelby.xyz/shelby
# shelbynet (uncomment if using shelbynet):
# NEXT_PUBLIC_SHELBY_RPC_URL=https://api.shelbynet.shelby.xyz/shelby

# ── Shelby Protocol Contract Address ─────────────
# Not configurable: the Shelby SDK hardcodes the deployer it registers blobs
# against, so this lives in lib/constants.ts and is asserted against the SDK at
# runtime. Setting it here would only describe a contract our blobs are not in.


# ── ExMarket Contract ────────────────────────────
# Your deployed ExMarket Move module address (set after `aptos move publish`)
# The platform registry lives at this same address on-chain, so there is no
# separate registry variable to set.
NEXT_PUBLIC_MODULE_ADDRESS=0xYOUR_EXMARKET_MODULE_ADDRESS

# ── API Keys ─────────────────────────────────────
# Server-only Aptos API key from Geomi. Do not prefix with NEXT_PUBLIC.
# Format: aptoslabs_***
APTOS_API_KEY=
APTOS_API_ORIGIN=http://localhost:3000
SHELBY_API_KEY=
